    {
      "name": "5. Shipment Tracking Milestone Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response time is less than 500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});",
              "",
              "pm.test('Tracking milestone status is DELIVERED or IN_TRANSIT', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('status');",
              "    pm.expect(['DELIVERED', 'IN_TRANSIT', 'SHIPPED']).to.include(jsonData.status);",
              "    if (jsonData.id) {",
              "        pm.environment.set('tracker_id', jsonData.id);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{current_access_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/shipping/trackers?transaction_id={{order_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "shipping", "trackers"],
          "query": [
            {
              "key": "transaction_id",
              "value": "{{order_id}}"
            }
          ]
        },
        "description": "Queries carrier shipment tracking milestone status for the authorized transaction."
      },
      "response": []
