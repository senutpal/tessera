{
  "name": "tessera-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint:boundaries": "node -e \"const fs=require('fs'),cp=require('child_process');cp.execSync('depcruise packages' + (fs.existsSync('apps') ? ' apps' : ''), {stdio:'inherit'})\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:postman": "tsx tests/postman/runPostmanTests.ts",
    "seed:demo": "tsx scripts/seedDemo.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@tessera/core": "workspace:*",
    "@tessera/event-bus": "workspace:*",
    "@tessera/mandates": "workspace:*",
    "@types/newman": "^5.3.6",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^16.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "newman": "^6.2.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "ioredis": "^6.0.0",
    "ws": "^8.22.0"
  }
}
