# Tessera Environment Variables Example

# Database Credentials
POSTGRES_USER=tessera_admin
POSTGRES_PASSWORD=tessera_dev_password
POSTGRES_DB=tessera

# Application Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Service Connections
DATABASE_URL=postgresql://tessera_admin:tessera_dev_password@localhost:5432/tessera
REDIS_URL=redis://localhost:6379

# Dashboard Public Endpoints
VITE_CLEARINGHOUSE_API_URL=http://localhost:3000
VITE_CLEARINGHOUSE_WS_URL=ws://localhost:3000

# PayPal Sandbox Credentials
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
